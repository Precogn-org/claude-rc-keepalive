# Exemple de configuration d'UNE session Remote Control. Le plus simple est de la creer avec :
#   claude-rc-ctl create <id> --name "Nom affiche" --dir /chemin/absolu/du/dossier
# Ce fichier s'appelle ~/.config/claude-rc/<id>.env ; syntaxe shell : NOM='valeur', sans espace autour du "=".
# Il ne doit contenir AUCUN secret : la connexion Claude est celle de `claude auth login`.

# Nom affiche dans claude.ai/code et dans l'application mobile : libre (espaces, accents, "/"...).
RC_NAME='Exemple de session'

# Dossier de travail : chemin ABSOLU et DURABLE, unique pour cette session (--continue y est lie).
# Refuses : /tmp, /var/tmp, /dev/shm, /run (vides au demarrage). Claude Code doit avoir approuve ce dossier une fois
# (dialogue "trust").
RC_DIR="$HOME/claude-rc/sessions/exemple"

# Mode de permission. Autorises : default, acceptEdits, plan. (bypassPermissions/auto/dontAsk refuses.)
RC_PERMISSION_MODE='acceptEdits'

# Repli quand --continue repond "No recent session found" (rien a reprendre) :
#   never    (defaut) aucune nouvelle session : decision humaine (claude-rc-ctl fresh <id> --yes)
#   norecord cree une nouvelle session, et seulement dans ce cas precis
RC_FALLBACK='never'

# --- Reglages avances (valeurs par defaut ; decommenter pour changer) ---
# CLAUDE_BIN="$HOME/.local/bin/claude"
# RC_TMUX_SESSION="rc-<id>"
# RC_CONTINUE_FAIL_SECONDS=45     # un echec de --continue avant ce delai est analyse (message lu a l'ecran)
# RC_MAX_LAUNCHES=3               # anti-boucle : au plus N lancements...
# RC_LAUNCH_WINDOW=600            # ...par fenetre de M secondes, puis pause automatique
# RC_MIN_AVAILABLE_MB=1024        # ne lance rien si la memoire disponible est inferieure (Mo)
# RC_LOG_MAX_BYTES=1048576        # rotation du journal (une generation conservee)
